export QSG_RHI_BACKEND=opengl

# Mapbox / MapLibre base map
export MAPBOX_ACCESS_TOKEN='your-mapbox-public-token'
export MAPBOX_STYLE_URL='mapbox://styles/your-account/your-style-id'

# OpenWeather click markers + raster overlay
export OPENWEATHERMAP_API_KEY='your-openweathermap-api-key'
export OPENWEATHERMAP_TILE_LAYER='WND'

# Local NetworkPlannerRpi simulation / replay bridge
# These match the RPi repo defaults when it runs with --simulation / replay on localhost.
export NPRPI_PILOT_HOST='127.0.0.1'
export NPRPI_MODEM_HOST='127.0.0.1'
export NPRPI_GIMBAL_HOST='127.0.0.1'

# Optional explicit GCS-side overrides. Leave commented unless you need different
# bind/remote endpoints than the NetworkPlannerRpi channel inversion.
# export NPGCS_PILOT_BIND_HOST='127.0.0.1'
# export NPGCS_PILOT_BIND_PORT='14551'
# export NPGCS_PILOT_REMOTE_HOST='127.0.0.1'
# export NPGCS_PILOT_REMOTE_PORT='14552'

# ns-3 live simulation bridge
export NS3_SIM_PORT='45454'
export NS3_SIM_RPI_PORT='45455'
export NS3_TELEMETRY_PAYLOAD='180'
export NS3_TELEMETRY_INTERVAL_MS='100'
export NS3_CONTROL_PAYLOAD='96'
export NS3_CONTROL_INTERVAL_MS='500'

# GCS-side collision detection / avoidance policy
# Defaults implement:
# - warning when 3D separation is below 10 m
# - alert when 3D separation is at or below 6 m
# - hard safety volume breach inside a 5 m x 5 m x 5 m box
export NP_GCS_COLLISION_WARNING_ENTER_M='10'
export NP_GCS_COLLISION_WARNING_EXIT_M='12'
export NP_GCS_COLLISION_ALERT_ENTER_M='6'
export NP_GCS_COLLISION_ALERT_EXIT_M='8'
export NP_GCS_COLLISION_SAFETY_AXIS_ENTER_M='5'
export NP_GCS_COLLISION_SAFETY_AXIS_EXIT_M='6'
export NP_GCS_COLLISION_COMMAND_INTERVAL_MS='350'
export NP_GCS_COLLISION_COMMAND_MAGNITUDE='760'
export NP_GCS_COLLISION_COMMAND_FLOOR='220'
export NP_GCS_COLLISION_SEND_MAVLINK_REPORT='1'

# LTE live / batch tuning
export NS3_LTE_INTERSITE_DISTANCE='750'
export NS3_LTE_COVERAGE_RADIUS='250'
export NS3_LTE_DL_BANDWIDTH='50'
export NS3_LTE_UL_BANDWIDTH='50'
export NS3_LTE_TX_POWER='30'

# NR live / batch tuning
export NS3_NR_BS_HEIGHT='35'
export NS3_NR_DISTANCE='500'
export NS3_NR_SCENARIO_WIDTH='1200'
export NS3_NR_SCENARIO_HEIGHT='1200'
export NS3_NR_FREQUENCY='3500000000'
export NS3_NR_BANDWIDTH='40000000'
export NS3_NR_NUMEROLOGY='1'
export NS3_NR_TX_POWER='43'

# Simulated RPi -> GCS video transport
export NPVIDEO_HOST='127.0.0.1'
export NPVIDEO_PORT='5600'
export NPVIDEO_CONTROL_PORT='5601'
export ORIGIN_LAT='39.904459'
export ORIGIN_LON='116.406847'
export MOBILITY='1'
export MOBILITY_RADIUS='80'
