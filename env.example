export QSG_RHI_BACKEND=opengl

# Mapbox / MapLibre base map
export MAPBOX_ACCESS_TOKEN='your-mapbox-public-token'
export MAPBOX_STYLE_URL='mapbox://styles/your-account/your-style-id'

# OpenWeather click markers + raster overlay
export OPENWEATHERMAP_API_KEY='your-openweathermap-api-key'
export OPENWEATHERMAP_TILE_LAYER='WND'

# Local NetworkPlannerRpi simulation / replay bridge
# These match the RPi repo defaults when it runs with --simulation / replay on localhost.
export NPRPI_PILOT_HOST='127.0.0.1'
export NPRPI_MODEM_HOST='127.0.0.1'
export NPRPI_GIMBAL_HOST='127.0.0.1'

# Optional explicit GCS-side overrides. Leave commented unless you need different
# bind/remote endpoints than the NetworkPlannerRpi channel inversion.
# export NPGCS_PILOT_BIND_HOST='127.0.0.1'
# export NPGCS_PILOT_BIND_PORT='14551'
# export NPGCS_PILOT_REMOTE_HOST='127.0.0.1'
# export NPGCS_PILOT_REMOTE_PORT='14552'

# ns-3 live simulation bridge
export NS3_SIM_PORT='45454'
export NS3_SIM_RPI_PORT='45455'

# Simulated RPi -> GCS video transport
export NPVIDEO_HOST='127.0.0.1'
export NPVIDEO_PORT='5600'
export ORIGIN_LAT='39.904459'
export ORIGIN_LON='116.406847'
export MOBILITY='1'
export MOBILITY_RADIUS='80'
